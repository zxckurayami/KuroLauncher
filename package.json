{
  "name": "kuro-launcher",
  "productName": "KuroLauncher",
  "version": "0.4.0",
  "description": "Modern Minecraft launcher with dark Japanese aesthetics.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 4173 --strictPort\" \"wait-on tcp:4173 && node scripts/launch-electron.js\"",
    "start": "node scripts/launch-electron.js",
    "build": "tsc && vite build",
    "package": "powershell -ExecutionPolicy Bypass -File installer/build-custom-installer.ps1",
    "package:nsis": "electron-builder",
    "preview": "vite preview",
    "test-api": "node scripts/test-curseforge-api.js"
  },
  "dependencies": {
    "@xmcl/installer": "^6.1.2",
    "adm-zip": "^0.5.17",
    "axios": "^1.5.1",
    "curseforge-api": "^1.0.0",
    "framer-motion": "^12.38.0",
    "minecraft-launcher-core": "^3.0.0",
    "node-fetch": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^1.0.15",
    "three": "^0.154.0"
  },
  "author": "KuroLauncher Team",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.kurolauncher.app",
    "productName": "KuroLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "logo/KuroLauncher.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "installerIcon": "installerIcon.ico",
      "uninstallerIcon": "uninstallerIcon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerHeaderIcon": "installerHeaderIcon.ico",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "include": "installer.nsh",
      "artifactName": "KuroLauncher-Setup-${version}-${arch}.${ext}",
      "uninstallDisplayName": "KuroLauncher ${version}",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": "KuroLauncher",
      "runAfterFinish": true,
      "shortcutName": "KuroLauncher"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "buildUnpack": "**/*.js",
  "publish": null
}
