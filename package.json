{
  "name": "kuro-launcher",
  "productName": "KuroLauncher",
  "version": "0.1.0",
  "description": "Modern Minecraft launcher with dark Japanese aesthetics.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 4173\" \"wait-on http://localhost:4173 && electron .\"",
    "start": "electron .",
    "build": "tsc && vite build",
    "package": "electron-builder",
    "preview": "vite preview",
    "test-api": "node scripts/test-curseforge-api.js"
  },
  "dependencies": {
    "@xmcl/installer": "^6.1.2",
    "adm-zip": "^0.5.17",
    "axios": "^1.5.1",
    "curseforge-api": "^1.0.0",
    "framer-motion": "^12.38.0",
    "minecraft-launcher-core": "^3.0.0",
    "node-fetch": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^1.0.15",
    "three": "^0.154.0"
  },
  "author": "KuroLauncher Team",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.kurolauncher.app",
    "productName": "KuroLauncher",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "logo/KuroLauncher.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KuroLauncher"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "buildUnpack": "**/*.js",
  "publish": null
}
